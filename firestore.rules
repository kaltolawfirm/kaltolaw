rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff accounts that may use the admin dashboard. Client portal users are
    // signed in too, so being signed in is not enough. Keep this list in sync
    // with KL_STAFF_EMAILS in admin.html (and ADMIN_EMAILS in functions/.env).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['info.blaw223@yahoo.com'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Website content edited in the dashboard's Website Editor (js/cms.js)
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CMS & Blog Content
    match /website_content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Blog posts. Visitors may only bump the engagement counters by one:
    // views and comments go up, likes go up or down (unlike), never below 0.
    function counterStep(field, allowDown) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return after == before
        || after == before + 1
        || (allowDown && after == before - 1 && after >= 0);
    }

    function isCounterBump() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['views', 'likes', 'comments'])
        && counterStep('views', false)
        && counterStep('likes', true)
        && counterStep('comments', false);
    }

    match /insights/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isCounterBump();

      // Public comments: name + text only, stamped with the server time.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin();
      }
    }

    // Enquiries & Appointments
    match /enquiries/{document=**} {
      allow create: if true;
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }
    match /appointments/{document=**} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin() || (request.auth != null && isOwner(resource.data.uid));
      allow update, delete: if isAdmin();
    }

    // Cases — clients can only read their own linked case
    match /cases/{document=**} {
      allow get: if true;
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      // Allow authenticated users to update uid field only (self-claim)
      allow update: if isAdmin() ||
        (request.auth != null &&
         request.writeFields.hasOnly(['uid']) &&
         resource.data.uid == null);
      allow create, delete: if isAdmin();
    }

    // Admin document vault
    match /documents/{document=**} {
      allow read, write: if isAdmin();
    }

    match /tasks/{document=**} {
      allow read, write: if isAdmin();
    }

    // Client upload metadata — owners can create & read their own
    match /client_uploads/{document=**} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Newsletter subscribers
    match /newsletter_subscribers/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Template requests
    match /template_requests/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Invoices: staff manage them; portal clients read their own. pay.html looks
    // invoices up and settles them through Cloud Functions (lookupInvoice,
    // verifyInvoicePayment), which verify the payment with Flutterwave first.
    match /invoices/{document=**} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    // Written only by verifyInvoicePayment (server), one record per transaction
    match /payment_records/{document=**} {
      allow read, write: if isAdmin();
    }

    // Client Portal User Profiles
    match /users/{uid} {
      allow read, write: if isAdmin() || isOwner(uid);
    }

    // Ask a Lawyer messages — clients own their messages
    match /messages/{document=**} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin(); // admin replies
      allow delete: if isAdmin();
    }

    // Client Satisfaction Ratings — clients create & read own; admin reads all
    match /ratings/{document=**} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // e-Signature Requests — admin creates; clients read & update their own (to sign)
    match /signature_requests/{document=**} {
      allow create, delete: if isAdmin();
      allow read: if isAdmin() || (request.auth != null && resource.data.clientUid == request.auth.uid);
      allow update: if isAdmin() || (request.auth != null && resource.data.clientUid == request.auth.uid);
    }

    // Email Campaigns — admin only
    match /campaigns/{document=**} {
      allow read, write: if isAdmin();
    }

    // Newsletter subscribers — anyone can subscribe; admin manages
    match /subscribers/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
